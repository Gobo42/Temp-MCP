      "max_rows": 1000,
      "default_limit": 500,
      "limit_argument": "limit",
      "empty_result": "not_found",
      "constraints": [
        {
          "kind": "time_range",
          "start": "start",
          "end": "end",
          "max_seconds": 2678400
        }
      ],
      "sql": "SELECT s.id AS sensor_id, s.name AS name, s.location AS location, CAST(? AS CHAR) AS requested_source, CASE WHEN m.id IS NULL THEN 0 ELSE 1 END AS reading_present, CASE WHEN m.id IS NULL THEN 'no_readings_in_range' ELSE 'data_available' END AS data_status, m.id AS measurement_id, m.source AS source, CASE WHEN m.source = 'live' THEN m.collected_at ELSE m.observed_at END AS reading_at, m.observed_at AS observed_at, m.collected_at AS collected_at, m.temperature_c AS temperature_c, m.humidity_pct AS humidity_pct, m.low_battery AS low_battery, m.resolution_seconds AS resolution_seconds FROM sensors s LEFT JOIN measurements m ON m.sensor_id = s.id AND m.source = ? AND ((? = 'live' AND m.collected_at >= ? AND m.collected_at < ?) OR (? = 'history' AND m.observed_at >= ? AND m.observed_at < ?)) WHERE s.id = ? ORDER BY CASE WHEN m.source = 'live' THEN m.collected_at ELSE m.observed_at END, m.id LIMIT ?"
