  "tools": [
    {
      "name": "list_sensors",
      "description": "List persisted sensors, metadata and latest live collection age. A recent collection does not prove a recent physical measurement.",
      "kind": "query",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        },
        "additionalProperties": false
      },
      "timeout_seconds": 5,
      "fields": [
        {
          "name": "sensor_id",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "location",
          "type": "string",
          "nullable": true
        },
        {
          "name": "model",
          "type": "string"
        },
        {
          "name": "stored_enabled",
          "type": "boolean"
        },
        {
          "name": "metadata_basis",
          "type": "string"
        },
        {
          "name": "reading_present",
          "type": "boolean"
        },
        {
          "name": "collected_at",
          "type": "timestamp",
          "nullable": true
        },
        {
          "name": "age_seconds",
          "type": "integer",
          "nullable": true,
          "description": "Age since collection; negative values indicate a future timestamp."
        },
        {
          "name": "clock_anomaly",
          "type": "boolean",
          "nullable": true
        },
        {
          "name": "collection_freshness",
          "type": "string"
        }
      ],
      "bindings": [
        {
          "source": "runtime",
          "name": "now_utc",
          "db_type": "timestamp"
        },
        {
          "source": "runtime",
          "name": "now_utc",
          "db_type": "timestamp"
        },
        {
          "source": "runtime",
          "name": "now_utc",
          "db_type": "timestamp"
        },
        {
          "source": "runtime",
          "name": "now_utc",
          "db_type": "timestamp"
        },
        {
          "source": "constant",
          "name": "stale_seconds",
          "db_type": "integer"
        },
        {
          "source": "runtime",
          "name": "fetch_limit",
          "db_type": "integer"
        }
      ],
      "max_rows": 1000,
      "default_limit": 100,
      "limit_argument": "limit",
      "empty_result": "empty",
      "sql": "WITH ranked AS (SELECT id, sensor_id, observed_at, collected_at, temperature_c, humidity_pct, low_battery, source, resolution_seconds, ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY collected_at DESC, id DESC) AS rank_num FROM measurements WHERE source = 'live') SELECT s.id AS sensor_id, s.name AS name, s.location AS location, s.model AS model, s.enabled AS stored_enabled, 'last_persisted_collector_state' AS metadata_basis, CASE WHEN m.id IS NULL THEN 0 ELSE 1 END AS reading_present, m.collected_at AS collected_at, TIMESTAMPDIFF(SECOND, m.collected_at, ?) AS age_seconds, CASE WHEN m.id IS NULL THEN NULL WHEN m.collected_at > ? THEN 1 ELSE 0 END AS clock_anomaly, CASE WHEN m.id IS NULL THEN 'no_reading' WHEN m.collected_at > ? THEN 'clock_anomaly' WHEN TIMESTAMPDIFF(SECOND, m.collected_at, ?) > ? THEN 'stale' ELSE 'recent_collection' END AS collection_freshness FROM sensors s LEFT JOIN ranked m ON m.sensor_id = s.id AND m.rank_num = 1 ORDER BY s.id LIMIT ?"
    },
