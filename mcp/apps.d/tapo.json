          "type": "boolean",
          "nullable": true
        },
        {
          "name": "resolution_seconds",
          "type": "integer",
          "nullable": true,
          "units": "s"
        }
      ],
      "bindings": [
        {
          "source": "argument",
          "name": "source",
          "db_type": "string"
        },
        {
          "source": "argument",
          "name": "source",
