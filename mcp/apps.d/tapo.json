      "max_rows": 1000,
      "default_limit": 100,
      "limit_argument": "limit",
      "empty_result": "not_found",
      "sql": "WITH ranked AS (SELECT id, sensor_id, observed_at, collected_at, temperature_c, humidity_pct, low_battery, source, resolution_seconds, ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY collected_at DESC, id DESC) AS rank_num FROM measurements WHERE source = 'live') SELECT s.id AS sensor_id, s.name AS name, s.location AS location, s.model AS model, s.enabled AS stored_enabled, 'last_persisted_collector_state' AS metadata_basis, CASE WHEN m.id IS NULL THEN 0 ELSE 1 END AS reading_present, m.collected_at AS collected_at, TIMESTAMPDIFF(SECOND, m.collected_at, ?) AS age_seconds, CASE WHEN m.id IS NULL THEN NULL WHEN m.collected_at > ? THEN 1 ELSE 0 END AS clock_anomaly, CASE WHEN m.id IS NULL THEN 'no_reading' WHEN m.collected_at > ? THEN 'clock_anomaly' WHEN TIMESTAMPDIFF(SECOND, m.collected_at, ?) > ? THEN 'stale' ELSE 'recent_collection' END AS collection_freshness, CASE WHEN cs.sensor_id IS NULL THEN 0 ELSE 1 END AS status_present, cs.last_attempt AS last_attempt, cs.last_success AS last_success, cs.updated_at AS updated_at, cs.consecutive_failures AS consecutive_failures, cs.last_error AS last_error, CASE WHEN cs.sensor_id IS NULL THEN 'unknown' WHEN cs.last_success IS NULL OR cs.consecutive_failures > 0 OR m.id IS NULL OR m.collected_at > ? OR TIMESTAMPDIFF(SECOND, m.collected_at, ?) > ? THEN 'degraded' ELSE 'healthy' END AS health FROM sensors s LEFT JOIN ranked m ON m.sensor_id = s.id AND m.rank_num = 1 LEFT JOIN collector_status cs ON cs.sensor_id = s.id WHERE (? IS NULL OR s.id = ?) ORDER BY s.id LIMIT ?"
    }
