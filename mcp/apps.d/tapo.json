      "max_rows": 1000,
      "default_limit": 100,
      "limit_argument": "limit",
      "empty_result": "not_found",
      "sql": "WITH ranked AS (SELECT id, sensor_id, observed_at, collected_at, temperature_c, humidity_pct, low_battery, source, resolution_seconds, ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY collected_at DESC, id DESC) AS rank_num FROM measurements WHERE source = 'live') SELECT s.id AS sensor_id, s.name AS name, s.location AS location, s.model AS model, s.enabled AS stored_enabled, 'last_persisted_collector_state' AS metadata_basis, CASE WHEN m.id IS NULL THEN 0 ELSE 1 END AS reading_present, m.collected_at AS collected_at, TIMESTAMPDIFF(SECOND, m.collected_at, ?) AS age_seconds, CASE WHEN m.id IS NULL THEN NULL WHEN m.collected_at > ? THEN 1 ELSE 0 END AS clock_anomaly, CASE WHEN m.id IS NULL THEN 'no_reading' WHEN m.collected_at > ? THEN 'clock_anomaly' WHEN TIMESTAMPDIFF(SECOND, m.collected_at, ?) > ? THEN 'stale' ELSE 'recent_collection' END AS collection_freshness, m.id AS measurement_id, m.observed_at AS observed_at, m.temperature_c AS temperature_c, m.humidity_pct AS humidity_pct, m.low_battery AS low_battery, 0 AS observation_freshness_known FROM sensors s LEFT JOIN ranked m ON m.sensor_id = s.id AND m.rank_num = 1 WHERE (? IS NULL OR s.id = ?) ORDER BY s.id LIMIT ?"
