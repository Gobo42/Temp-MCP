    {
      "name": "get_sensor_history",
      "description": "Read live snapshots or completed history intervals separately in [start,end). History uses observed time; live uses collection time. A known sensor without data returns a presence row.",
      "kind": "query",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 500
          },
          "sensor_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "maxLength": 128
